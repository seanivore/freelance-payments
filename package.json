{
  "name": "freelance-payments",
  "version": "1.0.0",
  "description": "Freelance payment micro-site with Stripe integration",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/styles.css --watch",
    "dev": "npm run watch:css",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1"
  },
  "dependencies": {
    "stripe": "^14.21.0"
  }
}
